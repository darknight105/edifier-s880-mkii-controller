    </Style>
    <Style TargetType="Slider"><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="0.5"/><Setter Property="SmallChange" Value="0.5"/><Setter Property="LargeChange" Value="0.5"/></Style>
