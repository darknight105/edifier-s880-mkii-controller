      <GeometryDrawing Brush="#F4F6F7"><GeometryDrawing.Geometry><RectangleGeometry Rect="28,19,44,62" RadiusX="11" RadiusY="11"/></GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing Brush="#1F6E82"><GeometryDrawing.Geometry><EllipseGeometry Center="50,42" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry></GeometryDrawing>
