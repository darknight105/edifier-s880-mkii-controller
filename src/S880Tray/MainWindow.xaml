<Window x:Class="S880Tray.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="S880 · Speaker Control" Icon="pack://application:,,,/Assets/s880-controller.ico" Width="680" Height="410" MinWidth="560" MinHeight="330" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="GainRailButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Width="3" HorizontalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GainFader" TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Border x:Name="GainFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="5,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource GainRailButton}" Background="{DynamicResource RailBrush}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="15" Height="9" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="1" CornerRadius="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource GainRailButton}" Background="{DynamicResource RailEmptyBrush}"/></Track.IncreaseRepeatButton></Track></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="GainFocus" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="GainFocus" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="VolumeRailButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="VolumeRail" TargetType="Slider">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="4,0">
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource VolumeRailButton}" Background="{DynamicResource RailBrush}"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="17" Height="17" Focusable="False" IsTabStop="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PanelBrush}" StrokeThickness="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource VolumeRailButton}" Background="{DynamicResource RailEmptyBrush}"/></Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusRing" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer Background="{DynamicResource SurfaceBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,10,12,8">
      <Grid Margin="4,0,4,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource S880HeaderMark}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="S880 MKII" FontFamily="Bahnschrift" FontSize="20" VerticalAlignment="Center"/></StackPanel>
        <CheckBox x:Name="StartupToggle" Grid.Column="1" Content="Start with Windows" Click="StartupClick" Margin="0,0,10,0" ToolTip="Launch S880 Controller to the tray when you sign in to Windows" AutomationProperties.HelpText="Launches S880 Controller to the system tray when you sign in to Windows."/>
        <Button x:Name="ThemeButton" Grid.Column="2" Content="Dark" Click="ThemeClick" Margin="0,0,8,0" ToolTip="Switch to dark theme"/>
        <Button x:Name="RefreshButton" Grid.Column="3" Click="RefreshClick" Margin="0,0,10,0" ToolTip="Read the speaker's current state">
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="RefreshGlyph" Text="↻" FontFamily="Segoe UI Symbol" RenderTransformOrigin="0.5,0.5" Margin="0,0,6,0"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock><TextBlock Text="Refresh"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource StatusIdleBrush}" Margin="0,0,6,0"/><TextBlock x:Name="ConnectionText" Text="Idle" Foreground="{DynamicResource MutedBrush}" MaxWidth="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
      </Grid>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid MinHeight="211">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="12,10,8,8">
            <StackPanel>
              <DockPanel Margin="0,0,0,7"><TextBlock Text="INPUT BANK" Style="{StaticResource MicroLabel}"/><TextBlock x:Name="InputText" Text="Not read" FontFamily="Bahnschrift" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
              <UniformGrid x:Name="SourceButtons" Columns="2"/>
              <TextBlock x:Name="ReadTimeText" Text="Refresh to read" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,3,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="14,10,14,8">
            <StackPanel>
              <TextBlock Text="SPEAKER LEVEL" Style="{StaticResource MicroLabel}"/>
              <TextBlock x:Name="VolumeValueText" Text="— / 30" FontFamily="Bahnschrift" FontSize="37" Margin="0,17,0,9"/>
              <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeRail}" Minimum="0" Maximum="30" Value="0" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" IsEnabled="False" MinHeight="32" Margin="-3,0,-3,0" AutomationProperties.Name="Speaker volume, levels 0 to 30"/>
              <TextBlock x:Name="VolumeHintText" Text="0–30 · release to set" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
              <TextBlock x:Name="VolumeTimeText" Text="Refresh to read" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2" Margin="10,10,8,8">
            <TextBlock Text="PRESET" Style="{StaticResource MicroLabel}" Margin="0,0,0,6"/>
            <UniformGrid x:Name="PresetButtons" Columns="1"/>
            <TextBlock x:Name="PresetStatus" Text="Not read" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Expander x:Name="CustomExpander" Header="Stored Custom gains" IsExpanded="False" Margin="4,8,4,0">
        <Border x:Name="CustomDrawer" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,6,0,0" RenderTransformOrigin="0.5,0"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
          <StackPanel>
            <DockPanel><TextBlock x:Name="GainDescription" Text="Saved Custom settings; factory preset curves are independent." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="420"/><TextBlock x:Name="GainTimeText" Text="Refresh to adjust" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
            <UniformGrid x:Name="BandControls" Columns="6" Margin="0,9,0,0"/>
            <DockPanel Margin="0,5,0,0"><TextBlock x:Name="DirtyText" Text="Release a slider to save its gain" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><Button x:Name="ApplyButton" Content="Send pending" Click="ApplyClick" HorizontalAlignment="Right" Margin="0" IsEnabled="False" Visibility="Hidden"/></DockPanel>
          </StackPanel>
        </Border>
      </Expander>
      <Grid Margin="4,6,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PresetExplanation" Text="Factory presets and saved Custom gains are independent." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0"/>
        <Button Grid.Column="1" Content="Logs" Click="LogsClick" Padding="8,2" Margin="0" ToolTip="Open detailed operation reports"/>
      </Grid>
      <Expander x:Name="DetailsExpander" Header="Details" Margin="4,3,4,0" FontSize="10" Foreground="{DynamicResource MutedBrush}">
        <Border Background="{DynamicResource DetailsBrush}" Padding="9" CornerRadius="3" Margin="0,5,0,0"><TextBlock x:Name="MessageText" Text="Refresh to read the speaker. Closing this window keeps the controller in the tray." TextWrapping="Wrap" Foreground="{DynamicResource DetailsTextBrush}" FontSize="11"/></Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
